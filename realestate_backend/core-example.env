# App environment
DATABASE_URL=postgres://clini:yourpassword@postgres:5432/clini_india
ANALYTICS_RETENTION_MONTHS=12
HIDE_SEEN_FEEDS=true
SEEN_FEEDS_RESET_THRESHOLD=0

# JWT Auth
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Firebase (use one of the two options below)
# Option 1 - file path (volume-mounted in Docker)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Option 2 - individual env vars
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
