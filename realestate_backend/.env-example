# App environment
DATABASE_URL=postgres://identity:identity@postgres:5432/identity
# Placeholder brand-name var — display strings still hardcode "RealEstate" for now;
# wire this in if/when branding needs to be config-driven.
REALESTATE_BRAND_NAME=RealEstate
ANALYTICS_RETENTION_MONTHS=12
# Exclude jobs/events the user has actually viewed (confirmed via
# POST /api/v1/feed/impressions, not merely served in a prior response) from future
# pages. Independent per type — e.g. disable for events while that market is thin,
# without affecting job exclusion. When exhausted (0 unseen eligible items remain),
# seen-history for the affected type is cleared and that type is refetched fresh.
HIDE_SEEN_JOBS=true
HIDE_SEEN_EVENTS=true
# Minimum matchScore (0-100) a job must have to be shown at all; 0 disables the filter.
# Applied to the already-reranked candidate window (exact, not inferred from page order).
MIN_MATCH_SCORE=0

# Feed tuning
# How many jobs are fetched from JobsService.getRelevantJobs per feed page. That query
# now does all eligibility filtering (embedding similarity >= 0.25, location, experience)
# and ordering (similarity DESC, freshness as tiebreak) directly in SQL, so the fetched
# order IS the final order — no JS-side reranking or "K-widening" is needed anymore.
# Keep this close to FEED_ORGANIC_LIMIT (a small buffer is fine for hasMore detection).
FEED_JOB_FETCH_LIMIT=20
# Number of events fetched from DB per page
FEED_EVENT_FETCH_LIMIT=4
# Jobs shown per block before each event slot (pattern: N jobs → 1 event)
FEED_JOB_BLOCK_SIZE=4
# Max organic (non-ad) items assembled per feed page
FEED_ORGANIC_LIMIT=20
# Insert one ad every N organic items
FEED_AD_INTERVAL=5
# Minimum cosine similarity (0–1) for event recommendations; 0 disables the filter
FEED_EVENT_MIN_SIMILARITY=0

# JWT Auth
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins.
# Use * to reflect any origin (needed for Capacitor WebView / mobile builds).
# For a deployed backend accessed from specific frontends, list them explicitly.
# Example: https://mobile.realestate.in,https://admin.realestate.in,http://localhost:8080,http://localhost:8081
CORS_ORIGINS=*

# Frontend URLs (used for OAuth redirects after social login)
APP_URL=https://mobile.realestate.in
ADMIN_URL=https://admin.realestate.in

# Google OAuth
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: {BACKEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-backend.com/api/v1/auth/google/callback

# Facebook OAuth
# Create app at: https://developers.facebook.com → My Apps → Create App
# Add product "Facebook Login", set Valid OAuth Redirect URI: {BACKEND_URL}/api/v1/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=https://your-backend.com/api/v1/auth/facebook/callback

# LinkedIn OAuth
# Create app at: https://www.linkedin.com/developers/apps
# Add products: "Sign In with LinkedIn using OpenID Connect"
# Authorised redirect URL: {BACKEND_URL}/api/v1/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=https://your-backend.com/api/v1/auth/linkedin/callback

# SMTP (for forgot-password emails)
# Works with any SMTP provider: Gmail, SendGrid, Resend, Mailgun, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
SMTP_FROM="RealEstate" <noreply@realestate.in>
