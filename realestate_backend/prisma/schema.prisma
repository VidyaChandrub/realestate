// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "users", "employers", "jobs", "applications", "ads", "events", "analytics", "notifications", "master_data", "admin", "audit", "reports"]
}

// =====================================================
// USERS MODULE
// =====================================================

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  username                   String?   @unique
  passwordHash               String    @map("password_hash")
  firstName                  String?   @map("first_name")
  lastName                   String?   @map("last_name")
  mobileNumber               String?   @map("mobile_number")
  role                       UserRole  @default(JOB_SEEKER)
  isActive                   Boolean   @default(true) @map("is_active")
  emailVerified              Boolean   @default(false) @map("email_verified")
  emailVerifiedAt            DateTime? @map("email_verified_at")
  emailVerificationToken     String?   @unique @map("email_verification_token")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  resendVerificationCount    Int       @default(0) @map("resend_verification_count")
  lastVerificationResendAt   DateTime? @map("last_verification_resend_at")
  verificationResendWindowStartedAt DateTime? @map("verification_resend_window_started_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at")

  employer Employer?

  @@map("users")
  @@schema("users")
}

enum UserRole {
  JOB_SEEKER
  EMPLOYER
  ADMIN

  @@schema("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
  @@schema("users")
}

model Profile {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  email          String?   @unique
  fullName       String?   @map("full_name")
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  phoneNumber    String?   @map("phone_number")
  mobileNumber   String?   @map("mobile_number")
  gender         String?
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  bio            String?
  avatarUrl      String?   @map("avatar_url")
  userType       String?   @map("user_type") // 'consumer', 'employer', 'admin'
  companyName    String?   @map("company_name")
  jobTitle       String?   @map("job_title")
  currentCityId  String?   @map("current_city_id") @db.Uuid
  stateId        String?   @map("state_id") @db.Uuid
  countryId      String?   @map("country_id") @db.Uuid
  pincode        String?
  nationality    String?

  // Professional background (High level)
  highestQualificationId   String? @map("highest_qualification_id") @db.Uuid
  currentJobTitle          String? @map("current_job_title")
  currentCompanyName       String? @map("current_company_name")
  experienceLevelId        String? @map("experience_level_id") @db.Uuid
  totalExperienceMonths    Int     @default(0) @map("total_experience_months")
  relevantExperienceMonths Int?    @map("relevant_experience_months")

  // Profile Status
  profileComplete             Boolean @default(false) @map("profile_complete")
  profileCompletionPercentage Int     @default(0) @map("profile_completion_percentage")

  // Job Preferences & Availability
  preferredEmploymentTypeId String[]            @default([]) @map("preferred_employment_type_id") @db.Uuid
  preferredWorkMode         PreferredWorkMode[] @default([]) @map("preferred_work_mode")
  preferredCategoryIds      String[]            @default([]) @map("preferred_category_ids") @db.Uuid
  preferredInterestIds      String[]            @default([]) @map("preferred_interest_ids") @db.Uuid
  availableJoiningDate      DateTime?           @map("available_joining_date") @db.Date
  shiftPreference           String?             @map("shift_preference")

  // Additional Information
  languagesKnown     Json?   @map("languages_known") // Array of strings
  linkedInProfileUrl String? @map("linkedin_profile_url")
  disabilityInfo     String? @map("disability_info")
  diversityInfo      String? @map("diversity_info")
  fatherMotherName   String? @map("father_mother_name")
  permanentAddress   String? @map("permanent_address")

  preferences          Json? @default("{}")
  notificationSettings Json? @default("{}") @map("notification_settings")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")
  isActive    Boolean   @default(true) @map("is_active")

  // Relations
  education           Education[]
  experience          ProfessionalExperience[]
  preferredLocations  UserPreferredLocation[]
  skills              UserSkill[]
  documents           UserDocument[]
  applications        Application[]
  savedJobs           SavedJob[]               @relation("SavedJobUser")
  eventRegistrations    EventRegistration[]
  eventExternalClicks   EventExternalClick[]
  jobExternalClicks     JobExternalClick[]
  advertisementClicks   AdvertisementClick[]
  advertisements      Advertisement[]

  @@index([currentCityId])
  @@index([stateId])
  @@index([countryId])
  @@index([highestQualificationId])
  @@index([experienceLevelId])
  @@index([preferredEmploymentTypeId], type: Gin)
  @@index([totalExperienceMonths])
  @@index([relevantExperienceMonths])
  @@index([currentCityId, experienceLevelId])
  @@index([preferredCategoryIds], type: Gin)
  @@index([preferredInterestIds], type: Gin)
  @@map("profiles")
  @@schema("users")
}

model Education {
  id                     String  @id @default(uuid())
  profileId              String  @map("profile_id")
  displayOrder           Int     @default(0) @map("display_order")
  highestQualificationId String  @map("highest_qualification_id") @db.Uuid
  specializationParentId String? @map("specialization_parent_id") @db.Uuid
  degreeName             String  @map("degree_name")
  specialization         String?
  customSpecialization   String? @map("custom_specialization")
  universityName         String? @map("university_name")
  yearOfPassing          Int?    @map("year_of_passing")
  percentage             String? @map("percentage") // Percentage / CGPA / Grade

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("education_details")
  @@schema("users")
}

model ProfessionalExperience {
  id                    String  @id @default(uuid())
  profileId             String  @map("profile_id")
  jobTitle              String  @map("job_title")
  companyName           String? @map("company_name")
  yearsOfExperience     Int?    @map("years_of_experience")
  monthsOfExperience    Int?    @map("months_of_experience")
  relevantYears         Int?    @map("relevant_years")
  relevantMonths        Int?    @map("relevant_months")
  employmentStatus      String? @map("employment_status")
  noticePeriod          String? @map("notice_period")
  currentSalary         Float?  @map("current_salary")
  expectedSalary        Float?  @map("expected_salary")
  willingnessToRelocate Boolean @default(false) @map("willingness_to_relocate")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("professional_experiences")
  @@schema("users")
}

model UserPreferredLocation {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @map("profile_id")
  locationId String   @map("location_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locationId])
  @@index([profileId])
  @@index([locationId])
  @@map("user_preferred_locations")
  @@schema("users")
}

enum PreferredWorkMode {
  REMOTE
  ONSITE
  HYBRID

  @@schema("users")
}

model UserSkill {
  id                String  @id @default(uuid())
  profileId         String  @map("profile_id")
  masterDataId      String? @map("master_data_id") @db.Uuid
  type              String  @default("PRIMARY") // PRIMARY, SECONDARY, TOOL
  yearsOfExperience Float?  @map("years_of_experience")
  certification     String?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("user_skills")
  @@schema("users")
}

model UserDocument {
  id        String   @id @default(uuid())
  profileId String   @map("profile_id")
  type      String // RESUME, COVER_LETTER, PORTFOLIO, CERTIFICATE
  name      String
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("user_documents")
  @@schema("users")
}

// =====================================================
// EMPLOYERS MODULE
// Matches 03-all-module-schema.sql + My previous impl
// =====================================================

model Organization {
  id          String  @id @default(uuid())
  name        String
  description String?
  industry    String?

  // Branding
  logoUrl       String?
  coverImageUrl String?  @map("cover_image_url")
  galleryImages String[] @default([]) @map("gallery_images")

  // Business Info
  website     String?
  foundedYear Int?              @map("founded_year")
  companySize CompanySize?      @map("company_size")
  type        OrganizationType?

  // Contact Info
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  // Location
  country    String?
  state      String?
  city       String?
  address    String?
  postalCode String? @map("postal_code")

  // Branding / Culture
  mission            String?
  vision             String?
  cultureDescription String?  @map("culture_description")
  benefits           String[] @default([])

  // Platform related
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  isFeatured         Boolean            @default(false) @map("is_featured")
  featuredUntil      DateTime?          @map("featured_until")
  subscriptionPlanId String?            @map("subscription_plan_id")

  // Stats
  jobsCount      Int @default(0) @map("jobs_count")
  employeesCount Int @default(0) @map("employees_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  isApproved  Boolean   @default(false) @map("is_approved")
  isSuspended Boolean   @default(false) @map("is_suspended")

  users          EmployerUser[]
  jobs           Job[]
  campaigns      Campaign[]
  events         Event[]
  advertisements Advertisement[]

  @@map("organizations")
  @@schema("employers")
}

enum OrganizationType {
  PRIVATE
  PUBLIC
  STARTUP
  NGO
  GOVERNMENT

  @@schema("employers")
}

enum CompanySize {
  ONE_TO_TEN                      @map("1-10")
  ELEVEN_TO_FIFTY                 @map("11-50")
  FIFTY_ONE_TO_TWO_HUNDRED        @map("51-200")
  TWO_HUNDRED_ONE_TO_FIVE_HUNDRED @map("201-500")
  FIVE_HUNDRED_PLUS               @map("500+")

  @@schema("employers")
}

enum VerificationStatus {
  PENDING
  APPROVED
  VERIFIED
  REJECTED
  SUSPENDED

  @@schema("employers")
}

model Employer {
  id             String    @id @default(uuid())
  userId         String?   @unique @map("user_id")
  email          String    @unique
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  lastLoginAt    DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])
  memberships EmployerUser[]

  @@map("employers")
  @@schema("employers")
}

model EmployerUser {
  id             String           @id @default(uuid())
  employerId     String           @map("employer_id")
  organizationId String           @map("organization_id")
  role           OrganizationRole

  status   EmployerUserStatus @default(INVITED)
  isActive Boolean            @default(true) @map("is_active")

  invitedById String?   @map("invited_by_id")
  invitedAt   DateTime? @map("invited_at")

  permissions String[] @default([])

  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  employer     Employer     @relation(fields: [employerId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([employerId, organizationId]) // Enforce unique membership
  @@map("employer_users")
  @@schema("employers")
}

enum EmployerUserStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@schema("employers")
}

enum OrganizationRole {
  OWNER
  HR
  RECRUITER

  @@schema("employers")
}

// =====================================================
// JOBS MODULE
// =====================================================

model Job {
  id                  String                       @id @default(uuid())
  organizationId      String                       @map("organization_id")
  organizationName    String?                      @map("organization_name")
  sourceName          String?                      @map("source_name")
  title               String
  description         String?
  descriptionPreview  String?                      @map("description_preview")
  summary             String?
  categoryId          String?                      @map("category_id") @db.Uuid
  locationId          String?                      @map("location_id") @db.Uuid
  minExperienceMonths Int?                         @map("min_experience_months")
  maxExperienceMonths Int?                         @map("max_experience_months")
  experienceLevelId   String?                      @map("experience_level_id") @db.Uuid
  educationLevelId    String?                      @map("education_level_id") @db.Uuid
  workMode            JobWorkMode?                 @map("work_mode")
  salaryMin           Int?                         @map("salary_min")
  salaryMax           Int?                         @map("salary_max")
  employmentTypeId    String?                      @map("employment_type_id") @db.Uuid
  jobType             JobType                      @default(INTERNAL) @map("job_type")
  externalUrl         String?                      @map("external_url")
  status              JobStatus                    @default(DRAFT)
  publishedAt         DateTime?                    @map("published_at")
  expiresAt           DateTime?                    @map("expires_at")
  rejectionReason     String?                      @map("rejection_reason")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @default(now()) @updatedAt @map("updated_at")
  backgroundImage     String? // Added to match dummy data/API requirements
  companyLogo         String?                      @map("company_logo") @db.Text
  keywords            Unsupported("tsvector")? @map("keywords")
  embedding           Unsupported("vector(1536)")? @map("embedding")

  organization   Organization       @relation(fields: [organizationId], references: [id])
  applications   Application[]
  savedJobs      SavedJob[]         @relation("SavedJobJob")
  externalClicks JobExternalClick[]

  location        Category? @relation("JobLocation", fields: [locationId], references: [id])
  category        Category? @relation("JobCategory", fields: [categoryId], references: [id])
  experienceLevel Category? @relation("JobExperienceLevel", fields: [experienceLevelId], references: [id])
  employmentType  Category? @relation("JobEmploymentType", fields: [employmentTypeId], references: [id])
  educationLevel  Category? @relation("JobEducationLevel", fields: [educationLevelId], references: [id])

  skills          JobSkill[]
  educationLevels JobEducation[]
  specializations  JobSpecialization[]

  @@index([status])
  @@index([educationLevelId])
  @@index([categoryId])
  @@index([locationId])
  @@index([experienceLevelId])
  @@index([employmentTypeId])
  @@index([status, expiresAt])
  @@index([locationId, status])
  @@index([minExperienceMonths, maxExperienceMonths])
  @@map("jobs")
  @@schema("jobs")
}

model JobSkill {
  id           String  @id @default(uuid())
  jobId        String  @map("job_id")
  masterDataId String? @map("master_data_id") @db.Uuid

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  skill Category? @relation("JobSkillMaster", fields: [masterDataId], references: [id])

  @@index([jobId])
  @@index([masterDataId])
  @@map("job_skills")
  @@schema("jobs")
}

model JobEducation {
  jobId       String @map("job_id")
  educationId String @map("education_id") @db.Uuid

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  education Category @relation(fields: [educationId], references: [id])

  @@id([jobId, educationId])
  @@index([educationId])
  @@map("job_educations")
  @@schema("jobs")
}

model JobSpecialization {
  jobId            String @map("job_id")
  specializationId String @map("specialization_id") @db.Uuid

  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  specialization Category @relation(fields: [specializationId], references: [id])

  @@id([jobId, specializationId])
  @@index([specializationId])
  @@map("job_specializations")
  @@schema("jobs")
}

model JobExternalClick {
  id        String   @id @default(uuid())
  jobId     String   @map("job_id")
  userId    String   @map("user_id")
  clickedAt DateTime @default(now()) @map("clicked_at")

  job  Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user Profile @relation(fields: [userId], references: [userId])

  @@index([jobId])
  @@index([userId])
  @@index([clickedAt])
  @@map("job_external_clicks")
  @@schema("jobs")
}

enum JobWorkMode {
  REMOTE
  ONSITE
  HYBRID

  @@schema("jobs")
}

enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
  EXPIRED
  ARCHIVED

  @@schema("jobs")
}

enum JobType {
  INTERNAL
  EXTERNAL

  @@schema("jobs")
}

// =====================================================
// APPLICATIONS MODULE
// =====================================================

model Application {
  id        String            @id @default(uuid())
  jobId     String            @map("job_id")
  userId    String            @map("user_id")
  coverNote String?           @map("cover_note")
  status    ApplicationStatus @default(SUBMITTED)
  appliedAt DateTime          @default(now()) @map("applied_at")
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at")

  job  Job     @relation(fields: [jobId], references: [id])
  user Profile @relation(fields: [userId], references: [userId])

  @@unique([jobId, userId])
  @@map("applications")
  @@schema("applications")
}

model SavedJob {
  id        String   @id @default(uuid())
  jobId     String   @map("job_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  job  Job     @relation("SavedJobJob", fields: [jobId], references: [id], onDelete: Cascade)
  user Profile @relation("SavedJobUser", fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([jobId, userId])
  @@map("saved_jobs")
  @@schema("applications")
}

enum ApplicationStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  REJECTED
  HIRED

  @@schema("applications")
}

// =====================================================
// ADS MODULE
// =====================================================

model Campaign {
  id                         String         @id @default(uuid())
  organizationId             String         @map("organization_id")
  name                       String
  type                       CampaignType
  entityType                 AdEntityType?  @map("entity_type")
  entityId                   String?        @map("entity_id")
  pricingModel               PricingModel   @map("pricing_model")
  status                     CampaignStatus @default(DRAFT)
  budgetTotal                Decimal        @map("budget_total") @db.Decimal(14, 4)
  budgetSpent                Decimal        @default(0) @map("budget_spent") @db.Decimal(14, 4)
  costPerClick               Decimal?       @map("cost_per_click") @db.Decimal(10, 4)
  costPerThousandImpressions Decimal?       @map("cost_per_thousand_impressions") @db.Decimal(10, 4)
  flatFee                    Decimal?       @map("flat_fee") @db.Decimal(14, 4)
  dailyLimit                 Decimal?       @map("daily_limit") @db.Decimal(14, 4)
  startDate                  DateTime?      @map("start_date")
  endDate                    DateTime?      @map("end_date")
  boostScore                 Int            @default(0) @map("boost_score")
  isArchived                 Boolean        @default(false) @map("is_archived")
  rejectionReason            String?        @map("rejection_reason")
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @default(now()) @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  deliveryStats DeliveryStats?
  creatives     Creative[]
  targetingRule TargetingRule?

  @@index([organizationId], name: "idx_campaigns_org_id")
  @@index([status], name: "idx_campaigns_status")
  @@index([startDate], name: "idx_campaigns_start_date")
  @@index([endDate], name: "idx_campaigns_end_date")
  @@map("campaigns")
  @@schema("ads")
}

model Creative {
  id           String   @id @default(uuid())
  campaignId   String   @map("campaign_id")
  mediaUrl     String   @map("media_url")
  thumbnailUrl String?  @map("thumbnail_url")
  headline     String
  description  String?
  ctaText      String   @map("cta_text")
  ctaUrl       String   @map("cta_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId], name: "idx_creatives_campaign_id")
  @@map("creatives")
  @@schema("ads")
}

model TargetingRule {
  id                    String   @id @default(uuid())
  campaignId            String   @unique @map("campaign_id")
  countryIds            String[] @default([]) @map("country_ids") @db.Uuid
  stateIds              String[] @default([]) @map("state_ids") @db.Uuid
  cityIds               String[] @default([]) @map("city_ids") @db.Uuid
  educationLevelIds     String[] @default([]) @map("education_level_ids") @db.Uuid
  experienceLevelIds    String[] @default([]) @map("experience_level_ids") @db.Uuid
  interestIds           String[] @default([]) @map("interest_ids") @db.Uuid
  demographicExtensions Json?    @map("demographic_extensions")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@map("targeting_rules")
  @@schema("ads")
}

enum CampaignType {
  IMAGE
  VIDEO
  SPONSORED_JOB
  SPONSORED_EVENT

  @@schema("ads")
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  PAUSED
  ENDED
  REJECTED

  @@schema("ads")
}

enum PricingModel {
  CPC
  CPM
  TIME_BASED

  @@schema("ads")
}

enum AdEntityType {
  JOB
  EVENT

  @@schema("ads")
}

model DeliveryStats {
  campaignId       String   @id @map("campaign_id")
  impressions      BigInt   @default(0)
  clicks           BigInt   @default(0)
  videoCompletions BigInt   @default(0) @map("video_completions")
  lastUpdatedAt    DateTime @default(now()) @map("last_updated_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@map("delivery_stats")
  @@schema("ads")
}

// =====================================================
// EVENTS MODULE
// =====================================================

model Event {
  id                      String                       @id @default(uuid())
  organizationId          String                       @map("organization_id")
  title                   String
  description             String?
  categoryId              String?                      @map("category_id") @db.Uuid
  mode                    EventMode                    @default(ONLINE)
  locationId              String?                      @map("location_id") @db.Uuid
  meetingUrl              String?                      @map("meeting_url")
  isMeetingUrlPublished   Boolean                      @default(false) @map("is_meeting_url_published")
  registrationType        RegistrationType             @default(INTERNAL) @map("registration_type")
  externalRegistrationUrl String?                      @map("external_registration_url")
  capacity                Int? // Null means unlimited
  startDate               DateTime?        @map("start_date")
  endDate                 DateTime?        @map("end_date")
  status                  EventStatus      @default(DRAFT)
  bannerImage             String?          @map("banner_image")
  tagIds                  String[]         @default([]) @map("tag_ids") 
  keywords                Unsupported("tsvector")? @map("keywords")
  embedding               Unsupported("vector(1536)")? @map("embedding")

  // Monetization fields
  isFree Boolean  @default(true) @map("is_free")
  price  Decimal? @db.Decimal(10, 2)

  // Sponsorship & Ads integration (future)
  isSponsored       Boolean @default(false) @map("is_sponsored")
  sponsorCampaignId String? @map("sponsor_campaign_id") // Soft link to ads.campaigns

  // Ranking / Feed boost (future)
  boostScore Int @default(0) @map("boost_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  organization    Organization          @relation(fields: [organizationId], references: [id])
  registrations   EventRegistration[]
  externalClicks  EventExternalClick[]

  @@index([organizationId])
  @@index([status])
  @@index([startDate])
  @@index([categoryId])
  @@index([locationId])
  @@map("events")
  @@schema("events")
}

enum EventMode {
  ONLINE
  OFFLINE

  @@schema("events")
}

enum EventStatus {
  DRAFT
  ACTIVE
  CANCELLED
  COMPLETED

  @@schema("events")
}

enum RegistrationType {
  INTERNAL
  EXTERNAL

  @@schema("events")
}

model EventRegistration {
  id           String             @id @default(uuid())
  eventId      String             @map("event_id")
  userId       String             @map("user_id") // keycloak user id
  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now()) @map("registered_at")
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id])
  user  Profile @relation(fields: [userId], references: [userId])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_registrations")
  @@schema("events")
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED

  @@schema("events")
}

model EventExternalClick {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  clickedAt DateTime @default(now()) @map("clicked_at")

  event Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  Profile @relation(fields: [userId], references: [userId])

  @@index([eventId])
  @@index([userId])
  @@map("event_external_clicks")
  @@schema("events")
}

// =====================================================
// ANALYTICS MODULE
// =====================================================

model AnalyticsEvent {
  id             String              @default(uuid()) @db.Uuid
  eventType      String              @map("event_type")
  userId         String?             @map("user_id")
  organizationId String?             @map("organization_id")
  entityType     AnalyticsEntityType @map("entity_type")
  entityId       String?             @map("entity_id")
  metadata       Json                @default("{}")
  ipAddress      String?             @map("ip_address")
  userAgent      String?             @map("user_agent")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([id, createdAt])
  @@index([createdAt], map: "idx_analytics_events_created_at")
  @@index([eventType], map: "idx_analytics_events_event_type")
  @@index([userId], map: "idx_analytics_events_user_id")
  @@index([organizationId], map: "idx_analytics_events_organization_id")
  @@map("analytics_events")
  @@schema("analytics")
}

model CampaignMetric {
  campaignId       String   @id @map("campaign_id") @db.Uuid
  impressions      BigInt   @default(0)
  clicks           BigInt   @default(0)
  videoCompletions BigInt   @default(0) @map("video_completions")
  spend            Decimal  @default(0) @db.Decimal(14, 2)
  lastUpdatedAt    DateTime @default(now()) @map("last_updated_at") @db.Timestamptz(6)

  @@map("campaign_metrics")
  @@schema("analytics")
}

model JobMetric {
  jobId         String   @id @map("job_id") @db.Uuid
  views         BigInt   @default(0)
  applications  BigInt   @default(0)
  lastUpdatedAt DateTime @default(now()) @map("last_updated_at") @db.Timestamptz(6)

  @@map("job_metrics")
  @@schema("analytics")
}

model EventMetric {
  eventId       String   @id @map("event_id") @db.Uuid
  views         BigInt   @default(0)
  registrations BigInt   @default(0)
  lastUpdatedAt DateTime @default(now()) @map("last_updated_at") @db.Timestamptz(6)

  @@map("event_metrics")
  @@schema("analytics")
}

model UserEngagementSummary {
  userId            String   @id @map("user_id")
  totalSessions     BigInt   @default(0) @map("total_sessions")
  totalClicks       BigInt   @default(0) @map("total_clicks")
  totalApplications BigInt   @default(0) @map("total_applications")
  lastActiveAt      DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)

  @@map("user_engagement_summary")
  @@schema("analytics")
}

model UserSeenFeed {
  userId     String    @map("user_id")
  entityId   String    @map("entity_id") @db.Uuid
  entityType String    @map("entity_type")
  // Set the moment an item is served in a feed response — does not mean the user
  // actually looked at it (e.g. it could be below the fold when they close the app).
  seenAt     DateTime  @default(now()) @map("seen_at") @db.Timestamptz(6)
  // Set only when the client confirms an actual impression (e.g. the item crossed a
  // visibility threshold in the viewport) via POST /api/v1/feed/impressions. Null
  // until then. This, not seenAt, is what drives hideSeenFeeds exclusion — an item
  // merely served but never viewed stays eligible to be shown again.
  viewedAt   DateTime? @map("viewed_at") @db.Timestamptz(6)

  @@id([userId, entityId])
  @@index([userId], map: "idx_user_seen_feed_user_id")
  @@map("user_seen_feed")
  @@schema("analytics")
}

enum AnalyticsEntityType {
  JOB
  EVENT
  AD
  APPLICATION
  SYSTEM

  @@schema("analytics")
}

// =====================================================
// NOTIFICATIONS MODULE
