// =====================================================
// ADVERTISEMENT MANAGEMENT MODULE
// =====================================================

model Advertisement {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  userId           String        @map("user_id")
  title            String
  description      String?
  redirectUrl      String?       @map("redirect_url")
  ctaText              String?               @map("cta_text")
  ctaTextColor         String?               @map("cta_text_color")
  ctaBackgroundColor   String?               @map("cta_background_color")
  ctaButtonStyle       AdCtaButtonStyle?     @map("cta_button_style")
  ctaButtonSize        AdCtaButtonSize?      @map("cta_button_size")
  ctaButtonPlacement   AdCtaButtonPlacement? @map("cta_button_placement")
  startDateTime    DateTime      @map("start_date_time")
  endDateTime      DateTime      @map("end_date_time")
  placement        AdPlacement
  priority         Int           @default(0)
  status           AdStatus      @default(ACTIVE)
  displayType      AdDisplayType @map("display_type")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at")

  organization   Organization             @relation(fields: [organizationId], references: [id])
  user           Profile                  @relation(fields: [userId], references: [userId])
  media          AdvertisementMedia[]
  targeting      AdvertisementTargeting[]
  clicks         AdvertisementClick[]

  @@index([organizationId])
  @@index([userId])
  @@map("advertisements")
  @@schema("ads")
}

model AdvertisementTargeting {
  id                 String   @id @default(uuid())
  advertisementId    String   @map("advertisement_id")
  countryIds         String[] @default([]) @map("country_ids") @db.Uuid
  stateIds           String[] @default([]) @map("state_ids") @db.Uuid
  cityIds            String[] @default([]) @map("city_ids") @db.Uuid
  skillIds           String[] @default([]) @map("skill_ids") @db.Uuid
  experienceLevelIds String[] @default([]) @map("experience_level_ids") @db.Uuid
  educationLevelIds  String[] @default([]) @map("education_level_ids") @db.Uuid
  specializationIds  String[] @default([]) @map("specialization_ids") @db.Uuid
  yearOfPassing      String[] @default([]) @map("year_of_passing")

  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  @@index([advertisementId])
  @@map("advertisement_targeting")
  @@schema("ads")
}

model AdvertisementClick {
  id                String   @id @default(uuid())
  advertisementId   String   @map("advertisement_id")
  userId            String   @map("user_id")
  userName          String   @map("user_name")
  email             String
  mobileNumber      String?  @map("mobile_number")
  locationId        String?  @map("location_id") @db.Uuid
  skillIds          String[] @default([]) @map("skill_ids") @db.Uuid
  experienceLevelId String?  @map("experience_level_id") @db.Uuid
  educationLevelId  String?  @map("education_level_id") @db.Uuid
  clickedAt         DateTime @default(now()) @map("clicked_at")
  metadata          Json?

  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  user          Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([advertisementId])
  @@index([userId])
  @@map("advertisement_clicks")
  @@schema("ads")
}

enum AdPlacement {
  DASHBOARD_BANNER
  JOB_LISTING
  SIDEBAR
  OTHER

  @@schema("ads")
}

enum AdStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  COMPLETED
  DRAFT

  @@schema("ads")
}

enum AdDisplayType {
  BANNER
  CARD

  @@schema("ads")
}

enum AdMediaType {
  IMAGE
  VIDEO
  HTML

  @@schema("ads")
}

enum AdCtaButtonStyle {
  FILLED
  OUTLINE
  GHOST
  TEXT

  @@schema("ads")
}

enum AdCtaButtonSize {
  SMALL
  MEDIUM
  LARGE

  @@schema("ads")
}

enum AdCtaButtonPlacement {
  BOTTOM_LEFT
  BOTTOM_CENTER
  BOTTOM_RIGHT
  TOP_LEFT
  TOP_CENTER
  TOP_RIGHT

  @@schema("ads")
}

model AdvertisementMedia {
  id              String      @id @default(uuid())
  advertisementId String      @map("advertisement_id")
  mediaUrl        String      @map("media_url")
  mediaType       AdMediaType @default(IMAGE) @map("media_type")
  order           Int         @default(0)
  thumbnailUrl    String?     @map("thumbnail_url")
  altText         String?     @map("alt_text")
  createdBy       String      @map("created_by")
  modifiedBy      String      @map("modified_by")
  createdAt       DateTime    @default(now()) @map("created_at")
  modifiedAt      DateTime    @default(now()) @updatedAt @map("modified_at")

  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  @@index([advertisementId])
  @@map("advertisement_media")
  @@schema("ads")
}

// =====================================================
// MENU / ROLE PERMISSIONS (master_data schema)
// =====================================================

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  rolePermissions RolePermission[]

  @@map("roles")
  @@schema("master_data")
}

model Menu {
  id         String   @id @default(uuid())
  label      String
  to         String
  icon       String
  groupLabel String?  @map("group_label")
  parentId   String?  @map("parent_id")
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  parent          Menu?            @relation("MenuChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children        Menu[]           @relation("MenuChildren")
  rolePermissions RolePermission[]

  @@map("menus")
  @@schema("master_data")
}

model RolePermission {
  id        String   @id @default(uuid())
  roleId    String   @map("role_id")
  menuId    String   @map("menu_id")
  createdAt DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId], map: "uq_role_menu")
  @@map("role_permissions")
  @@schema("master_data")
}
