enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  JOB_POSTED
  APPLICATION_RECEIVED
  STATUS_CHANGED
  EVENT_REMINDER
  EVENT_UPDATED

  @@schema("notifications")
}

enum EntityType {
  JOB
  APPLICATION
  EVENT
  SYSTEM

  @@schema("notifications")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  message    String
  entityType EntityType       @map("entity_type")
  entityId   String?          @map("entity_id")
  isRead     Boolean          @default(false) @map("is_read")
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
  @@schema("notifications")
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB

  @@schema("notifications")
}

model DeviceToken {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  deviceId   String         @map("device_id")
  token      String         @unique
  platform   DevicePlatform
  deviceName String?        @map("device_name")
  appVersion String?        @map("app_version")
  isActive   Boolean        @default(true) @map("is_active")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([deviceId])
  @@index([isActive])
  @@map("device_tokens")
  @@schema("notifications")
}

enum BroadcastStatus {
  PENDING
  SENDING
  COMPLETED
  FAILED
  NO_RECIPIENTS

  @@schema("notifications")
}

model BroadcastNotification {
  id             String          @id @default(uuid())
  title          String
  message        String
  status         BroadcastStatus @default(PENDING)
  recipientCount Int             @default(0) @map("recipient_count")
  successCount   Int             @default(0) @map("success_count")
  failureCount   Int             @default(0) @map("failure_count")
  targetingRules Json            @map("targeting_rules")
  targetingSummary Json?         @map("targeting_summary")
  actionUrl      String?         @map("action_url")
  createdBy      String          @map("created_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  sentAt         DateTime?       @map("sent_at")

  @@index([status])
  @@index([createdAt])
  @@map("broadcast_notifications")
  @@schema("notifications")
}

// =====================================================
// MASTER DATA MODULE
// =====================================================

model Category {
  id          String                 @id @default(uuid()) @db.Uuid
  type        MasterDataCategoryType
  value       String
  slug        String
  description String?
  parentId    String?                @map("parent_id") @db.Uuid
  isActive    Boolean                @default(true) @map("is_active")
  sortOrder   Int                    @default(0) @map("sort_order")
  metadata    Json?
  status      MasterStatus           @default(DRAFT)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  jobLocations        Job[]          @relation("JobLocation")
  jobCategories       Job[]          @relation("JobCategory")
  jobExperienceLevels Job[]          @relation("JobExperienceLevel")
  jobEducationLevels  Job[]          @relation("JobEducationLevel")
  jobEducations       JobEducation[]
  jobSpecializations  JobSpecialization[]
  jobEmploymentTypes  Job[]          @relation("JobEmploymentType")
  jobSkills           JobSkill[]     @relation("JobSkillMaster")

  @@unique([type, slug], map: "uq_master_data_category_type_slug")
  @@index([type])
  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
  @@schema("master_data")
}

enum MasterDataCategoryType {
  JOB_CATEGORY
  EVENT_CATEGORY
  EDUCATION_LEVEL
  SPECIALIZATION
  EXPERIENCE_LEVEL
  EMPLOYMENT_TYPE
  LOCATION_COUNTRY
  LOCATION_STATE
  LOCATION_CITY
  SKILL
  INDUSTRY
  ORGANIZATION_TYPE
  AD_INTEREST
  SYSTEM_TAG

  @@schema("master_data")
}

enum MasterStatus {
  DRAFT
  ACTIVE
  INACTIVE @map("CLOSED")

  @@schema("master_data")
}

