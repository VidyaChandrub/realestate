generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "access", "templates", "audit"]
}

// ---------------------------------------------------------------------------
// Enums
// (Enums belong to whichever schema uses them; Prisma requires one
//  @@schema per enum too when multiSchema is on.)
// ---------------------------------------------------------------------------

enum OrgStatus {
  draft
  active
  disabled

  @@schema("identity")
}

enum UserStatus {
  active
  disabled

  @@schema("identity")
}

enum RoleScope {
  platform
  organisation
  team

  @@schema("identity")
}

// ---------------------------------------------------------------------------
// identity — organisations, users, roles, auth tokens
// (Same idea as QuesPro's "admin" schema — the core identity/account layer)
// ---------------------------------------------------------------------------

model Organisation {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  city      String
  status    OrgStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at")

  users       User[]
  teams       Team[]
  auditLogs   AuditLog[]

  @@map("organisations")
  @@schema("identity")
}

model User {
  id                   String     @id @default(uuid())
  orgId                String?    @map("org_id")
  firstName            String?    @map("first_name")
  lastName             String?    @map("last_name")
  email                String     @unique
  phoneNumber          String?    @map("phone_number")
  passwordHash         String     @map("password_hash")
  status               UserStatus @default(active)
  mustChangePassword   Boolean    @default(false) @map("must_change_password")
  failedLoginAttempts  Int        @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?  @map("locked_until")
  createdAt            DateTime   @default(now()) @map("created_at")

  organisation   Organisation?        @relation(fields: [orgId], references: [id])
  userRoles      UserRole[]
  teamMembers    TeamMember[]
  refreshTokens  RefreshToken[]
  resetTokens    PasswordResetToken[]
  auditLogs      AuditLog[]

  @@map("users")
  @@schema("identity")
}

model Role {
  id        String    @id @default(uuid())
  key       String    @unique // super_admin / admin / manager / sales
  name      String
  scope     RoleScope
  sortOrder Int       @default(0) @map("sort_order")

  userRoles   UserRole[]
  permissions RoleModulePermission[]

  @@map("roles")
  @@schema("identity")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("identity")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@schema("identity")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// access — teams, membership, and the two-layer permission model
// ---------------------------------------------------------------------------

model Team {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  moduleAccess TeamModuleAccess[]

  @@map("teams")
  @@schema("access")
}

model TeamMember {
  teamId String @map("team_id")
  userId String @map("user_id")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
  @@schema("access")
}

// Layer 1 — which modules are in scope for a team at all
model TeamModuleAccess {
  teamId    String  @map("team_id")
  moduleKey String  @map("module_key")
  isEnabled Boolean @default(true) @map("is_enabled")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, moduleKey])
  @@map("team_module_access")
  @@schema("access")
}

// Layer 2 — what a role can do within a module, once it's in scope for the team
model RoleModulePermission {
  roleId    String  @map("role_id")
  moduleKey String  @map("module_key")
  canView   Boolean @default(true) @map("can_view")
  canAdd    Boolean @default(false) @map("can_add")
  canEdit   Boolean @default(false) @map("can_edit")
  canDelete Boolean @default(false) @map("can_delete")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, moduleKey])
  @@map("role_module_permissions")
  @@schema("access")
}

// ---------------------------------------------------------------------------
// audit — logging, kept separate the same way QuesPro isolates "audit"
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  orgId     String?  @map("org_id")
  actorId   String?  @map("actor_id")
  moduleKey String?  @map("module_key")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [orgId], references: [id])
  actor        User?         @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
  @@schema("audit")
}
