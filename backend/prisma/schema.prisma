generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "access", "templates", "audit", "billing", "projects"]
}

// ---------------------------------------------------------------------------
// Enums
// (Enums belong to whichever schema uses them; Prisma requires one
//  @@schema per enum too when multiSchema is on.)
// ---------------------------------------------------------------------------

enum OrgStatus {
  draft
  active
  disabled
  pending
  rejected

  @@schema("identity")
}

enum UserStatus {
  active
  disabled

  @@schema("identity")
}

// Furthest step the signup wizard has *completed* for this user — resume
// logic shows the step after this one. The values below are just the
// allowed set; progression ORDER is defined separately in
// common/utils/onboarding.util.ts's ONBOARDING_STEP_ORDER (not by the
// declaration order here, which isn't relied on anywhere).
enum OnboardingStep {
  account
  organisation
  business_details
  modules
  subscription
  templates
  invite
  connect
  completed

  @@schema("identity")
}

enum RoleScope {
  platform
  organisation
  team

  @@schema("identity")
}

// What kind of real-estate business the org is — collected at Step 2 of the
// signup wizard (previously collected in the UI but discarded, never
// persisted) and editable later from Org Settings → General. Fixed,
// app-controlled list, hence an enum rather than free text.
enum OrgIndustry {
  developer
  broker
  channel
  mixed

  @@schema("identity")
}

// ---------------------------------------------------------------------------
// identity — organisations, users, roles, auth tokens
// (Same idea as QuesPro's "admin" schema — the core identity/account layer)
// ---------------------------------------------------------------------------

model Organisation {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  // Nullable: the wizard creates the Organisation at Step 2 (name +
  // subdomain only) — city is collected later, at Step 3 (Business
  // Details). Every other org-creation path (Super Admin onboarding,
  // old atomic signup) still supplies it upfront.
  city      String?
  status    OrgStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at")

  // Profile fields — added for the Org Admin settings screen. All nullable
  // except the three with sensible defaults; existing orgs backfill to those.
  timezone        String  @default("Asia/Kolkata")
  currency        String  @default("INR")
  defaultLanguage String  @default("en-IN") @map("default_language")
  logoUrl         String? @map("logo_url")
  faviconUrl      String? @map("favicon_url")
  brandColour     String? @map("brand_colour")
  website         String?
  addressLine1    String? @map("address_line1")
  addressLine2    String? @map("address_line2")
  state           String?
  postalCode      String? @map("postal_code")
  country         String?

  // Business-details step of the signup wizard (Step 3). Both nullable —
  // compliance info a business may not have on day one.
  reraLicenseNo String? @map("rera_license_no")
  gstin         String? @map("gstin")

  // Organisation step of the signup wizard (Step 2) — bucket-style value
  // ("Just me", "2–10", "11–50", "50+"), stored as entered rather than a
  // separate code, matching how it was originally collected.
  teamSize String? @map("team_size")

  // Org Settings → General profile fields. All nullable — most orgs won't
  // have these on day one, and existing rows backfill to null.
  legalName    String?      @map("legal_name")
  industry     OrgIndustry?
  supportEmail String?      @map("support_email")
  supportPhone String?      @map("support_phone")

  // Modules step of the signup wizard (Step 6, skippable) — informational
  // only for now, no enforcement reads this yet (see prompt: out of scope).
  enabledModules String[] @default([]) @map("enabled_modules")

  // The organisation's own site identity, chosen at registration and/or later
  // from the Org Settings → Domain screen. subdomain is the organisation's
  // primary platform address (e.g. skylinedev.ipixxel.in) and is auto-activated
  // once the Super Admin approves the organisation. A custom domain can be
  // requested (added as a pending OrgDomainRequest) and, once a Super Admin
  // approves, is mapped to the organisation's primary site.
  // Per-website addresses (each template can have its own subdomain or a custom
  // domain) live on LandingPage / DomainRequest instead.
  subdomain          String?  @unique
  subdomainStatus    String   @default("pending") @map("subdomain_status") // none | pending | active | rejected
  customDomain       String?  @unique @map("custom_domain")
  customDomainStatus String   @default("none") @map("custom_domain_status") // none | pending | approved | connected | rejected

  // Set by AdminOrganisationsService.rejectPending when a Super Admin
  // rejects a pending registration — the mandatory reason they entered.
  // Surfaced back in the Super Admin organisations list/detail (an info
  // tooltip next to the "Rejected" status badge) so the decision stays on
  // record. Cleared if the org is later reactivated (see updateStatus).
  rejectionReason String? @map("rejection_reason")

  users                 User[]
  teams                 Team[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  subscriptions         Subscription[]
  organisationTemplates OrganisationTemplate[]
  landingPages          LandingPage[]
  typographySets        TypographySet[]
  domainRequests        DomainRequest[]
  orgDomainRequests     OrgDomainRequest[]
  trackingEvents        TrackingEvent[]
  projects              Project[]
  catalogOptions        OrgCatalogOption[]

  @@map("organisations")
  @@schema("identity")
}

model User {
  id                  String     @id @default(uuid())
  orgId               String?    @map("org_id")
  firstName           String?    @map("first_name")
  lastName            String?    @map("last_name")
  email               String     @unique
  phoneNumber         String?    @map("phone_number")
  passwordHash        String     @map("password_hash")
  status              UserStatus @default(active)
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  createdAt           DateTime   @default(now()) @map("created_at")

  // Signup-wizard resume tracking. Lives on User (not Organisation) for the
  // whole flow, including after the org exists — simplest single source of
  // truth, and avoids a dual-read on login (see common/utils/onboarding.util.ts).
  // Defaults to 'account' since a User row is only ever created once Step 1
  // (Account) has actually completed.
  onboardingStep OnboardingStep @default(account) @map("onboarding_step")

  organisation    Organisation?        @relation(fields: [orgId], references: [id])
  userRoles       UserRole[]
  teamMembers     TeamMember[]
  refreshTokens   RefreshToken[]
  resetTokens     PasswordResetToken[]
  auditLogs       AuditLog[]
  managedProjects Project[]
  salesProjects   ProjectSalesAgent[]
  assignedLeads   Lead[]
  callLogs        CallLog[]
  activityEvents  ActivityEvent[]
  notifications   Notification[]

  @@map("users")
  @@schema("identity")
}

model Role {
  id        String    @id @default(uuid())
  key       String    @unique // super_admin / admin / manager / sales
  name      String
  scope     RoleScope
  sortOrder Int       @default(0) @map("sort_order")

  userRoles   UserRole[]
  permissions RoleModulePermission[]

  @@map("roles")
  @@schema("identity")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("identity")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@schema("identity")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// access — teams, membership, and the two-layer permission model
// ---------------------------------------------------------------------------

model Team {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  moduleAccess TeamModuleAccess[]

  @@map("teams")
  @@schema("access")
}

model TeamMember {
  teamId String @map("team_id")
  userId String @map("user_id")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
  @@schema("access")
}

// Layer 1 — which modules are in scope for a team at all
model TeamModuleAccess {
  teamId    String  @map("team_id")
  moduleKey String  @map("module_key")
  isEnabled Boolean @default(true) @map("is_enabled")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, moduleKey])
  @@map("team_module_access")
  @@schema("access")
}

// Layer 2 — what a role can do within a module, once it's in scope for the team
model RoleModulePermission {
  roleId    String  @map("role_id")
  moduleKey String  @map("module_key")
  canView   Boolean @default(true) @map("can_view")
  canAdd    Boolean @default(false) @map("can_add")
  canEdit   Boolean @default(false) @map("can_edit")
  canDelete Boolean @default(false) @map("can_delete")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, moduleKey])
  @@map("role_module_permissions")
  @@schema("access")
}

// ---------------------------------------------------------------------------
// audit — logging, kept separate the same way QuesPro isolates "audit"
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  orgId     String?  @map("org_id")
  actorId   String?  @map("actor_id")
  moduleKey String?  @map("module_key")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [orgId], references: [id])
  actor        User?         @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// Notifications — in-app alerts surfaced to a recipient (typically a Super
// Admin) when something needs attention, e.g. an organisation registration or
// a domain/subdomain request waiting for approval. Email delivery stays
// stubbed via console.log (matching the rest of the codebase); this row is the
// durable, queryable "notification" the UI reads for the bell / approvals.
// ---------------------------------------------------------------------------

enum NotificationType {
  organisation_registration
  subdomain_request
  custom_domain_request
  organisation_approved
  organisation_rejected

  @@schema("audit")
}

model Notification {
  id        String           @id @default(uuid())
  orgId     String?          @map("org_id")
  recipientId String?        @map("recipient_id") // user id; null = all super admins (cosmetic grouping)
  type      NotificationType
  title     String
  body      String?
  entity    String?          // e.g. "Organisation" | "OrgDomainRequest"
  entityId  String?          @map("entity_id")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [orgId], references: [id])
  recipient    User?         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@index([type])
  @@map("notifications")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// templates — Super Admin landing-page template library (builder content
// lives in `content`, stored as-is; the frontend owns the shape of that JSON)
// ---------------------------------------------------------------------------

enum TemplateStatus {
  draft
  published
  scheduled
  password
  unpublished

  @@schema("templates")
}

enum TemplateKind {
  preset
  custom

  @@schema("templates")
}

enum TemplatePageType {
  landing
  thank_you

  @@schema("templates")
}

model Template {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  status         TemplateStatus   @default(draft)
  isPaid         Boolean          @default(false) @map("is_paid")
  thumbnail      String?
  designId       String           @map("design_id")
  baseDesignName String           @map("base_design_name")
  category       String?
  kind           TemplateKind     @default(custom)
  pageType       TemplatePageType @default(landing) @map("page_type")
  parentId       String?          @map("parent_id")
  domain         String           @default("")
  content        Json
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  parent                Template?              @relation("TemplatePages", fields: [parentId], references: [id], onDelete: SetNull)
  childPages            Template[]             @relation("TemplatePages")
  organisationTemplates OrganisationTemplate[]
  landingPages          LandingPage[]

  @@map("templates")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// billing — plans & subscriptions
// ---------------------------------------------------------------------------

enum BillingCycle {
  monthly
  yearly

  @@schema("billing")
}

enum SubscriptionStatus {
  active
  past_due
  trial
  cancelled
  paused

  @@schema("billing")
}

model Plan {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?  @default("")
  priceMonthly Int      @map("price_monthly")
  priceYearly  Int      @map("price_yearly")
  features     Json     @default("[]")
  limits       Json? // { projects, users, templates }
  color        String   @default("#eef0fe")
  badge        String   @default("b-indigo")
  isPopular    Boolean  @default(false) @map("is_popular")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
  @@schema("billing")
}

model Subscription {
  id           String             @id @default(uuid())
  orgId        String             @map("org_id")
  planId       String             @map("plan_id")
  billingCycle BillingCycle       @default(monthly) @map("billing_cycle")
  status       SubscriptionStatus @default(active)
  amount       Int
  currency     String             @default("INR")
  renewsAt     DateTime?          @map("renews_at")
  mrr          Int? // monthly recurring normalized value
  startedAt    DateTime           @default(now()) @map("started_at")
  cancelledAt  DateTime?          @map("cancelled_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
  @@schema("billing")
}

model OrganisationTemplate {
  orgId      String   @map("org_id")
  templateId String   @map("template_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([orgId, templateId])
  @@index([templateId])
  @@map("organisation_templates")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Org-owned landing pages — an org's own independent, editable copy made by
// "using" an assigned Template. The Template row is never mutated by this;
// see LandingPagesService for the copy-on-use guarantee.
// ---------------------------------------------------------------------------

enum LandingPageStatus {
  draft
  pending_approval
  approved
  rejected
  published
  unpublished

  @@schema("templates")
}

model LandingPage {
  id               String            @id @default(uuid())
  orgId            String            @map("org_id")
  teamId           String?           @map("team_id") // nullable — reserved for later team-level delegation, unused for now
  sourceTemplateId String?           @map("source_template_id")
  name             String
  slug             String
  status           LandingPageStatus @default(draft)
  content          Json // { sections, config } — the org's own copy
  thumbnail        String?
  pageType         TemplatePageType  @default(landing) @map("page_type")
  parentId         String?           @map("parent_id") // thank-you companion linkage, among the org's own pages
  // Optional per-website subdomain (e.g. abc.platform.com). A website can have
  // EITHER a subdomain OR a custom domain (via DomainRequest), mapped
  // Subdomain/Domain -> Organisation -> LandingPage.
  subdomain       String?           @unique
  subdomainStatus String            @default("none") @map("subdomain_status") // none | pending | active | rejected
  submittedAt      DateTime?         @map("submitted_at")
  reviewedAt       DateTime?         @map("reviewed_at")
  reviewedById     String?           @map("reviewed_by_id")
  rejectionReason  String?           @map("rejection_reason")
  publishedAt      DateTime?         @map("published_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organisation   Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sourceTemplate Template?     @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  parent         LandingPage?  @relation("LandingPageCompanion", fields: [parentId], references: [id], onDelete: SetNull)
  children       LandingPage[] @relation("LandingPageCompanion")
  domainRequest  DomainRequest?
  trackingEvents TrackingEvent[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([status])
  @@map("landing_pages")
  @@schema("templates")
}

model TypographySet {
  id        String   @id @default(uuid())
  orgId     String?  @map("org_id") // null = platform-wide set (Super Admin owned)
  name      String
  tokens    Json // the design-system token payload (TemplateTypography), stored as-is
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organisation Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // NOTE: Postgres never treats two NULLs as equal for uniqueness, so this
  // does NOT stop two platform sets (orgId: null) from sharing a name — it
  // only blocks duplicate names within one real org. Accepted deliberately:
  // platform sets are Super-Admin-only, a single trusted role that can just
  // not do that, and a real DB-level fix needs a partial unique index
  // (WHERE org_id IS NULL) outside what this schema DSL can express.
  @@unique([orgId, name])
  @@map("typography_sets")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Template-isolated website stack — Organisation → Template → Pages → Domain
// → DNS → SSL → Tracking → SEO → Publishing. Every LandingPage is an
// independent website instance (see prompt §1, §30).
// ---------------------------------------------------------------------------

enum OrgDomainRequestKind {
  subdomain
  custom_domain

  @@schema("templates")
}

enum OrgDomainRequestStatus {
  pending
  approved
  rejected
  connected

  @@schema("templates")
}

// A Super-Admin-reviewed request to claim the organisation's own site address:
// a platform subdomain (kind = "subdomain") or a custom domain (kind =
// "custom_domain"). These are the rows the Super Admin "Org Domains" screen
// lists and approves/rejects across all organisations. Approval writes the
// ground truth onto Organisation:
//   - subdomain     -> Organisation.subdomain + subdomainStatus = active
//   - custom_domain -> Organisation.customDomain + customDomainStatus = connected
// This is distinct from DomainRequest/LandingPage, which handle per-website
// custom-domain mapping for a specific landing page.
model OrgDomainRequest {
  id              String                 @id @default(uuid())
  orgId           String                 @map("org_id")
  kind            OrgDomainRequestKind
  subdomain       String?
  customDomain    String?                @map("custom_domain")
  status          OrgDomainRequestStatus @default(pending)
  requestedBy     String?                @map("requested_by")
  requestedAt     DateTime               @default(now()) @map("requested_at")
  reviewedAt      DateTime?              @map("reviewed_at")
  reviewedBy      String?                @map("reviewed_by")
  rejectionReason String?                @map("rejection_reason")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([status])
  @@map("org_domain_requests")
  @@schema("templates")
}

enum DomainRequestStatus {
  pending
  approved
  rejected
  dns_required
  verification_pending
  verified
  ssl_pending
  connected
  verification_failed
  connection_failed

  @@schema("templates")
}

enum DnsStatus {
  pending
  verified
  failed

  @@schema("templates")
}

enum SslStatus {
  pending
  active
  failed
  expired

  @@schema("templates")
}

model DomainRequest {
  id              String              @id @default(uuid())
  orgId           String              @map("org_id")
  landingPageId   String              @unique @map("landing_page_id")
  domain          String
  status          DomainRequestStatus @default(pending)
  requestedBy     String?             @map("requested_by")
  requestedAt     DateTime            @default(now()) @map("requested_at")
  reviewedAt      DateTime?           @map("reviewed_at")
  reviewedBy      String?             @map("reviewed_by")
  rejectionReason String?             @map("rejection_reason")
  dnsStatus       DnsStatus           @default(pending) @map("dns_status")
  sslStatus       SslStatus           @default(pending) @map("ssl_status")
  verificationToken String            @map("verification_token")
  dnsInstructions Json?               @map("dns_instructions")
  expectedRecords Json?               @map("expected_records")
  detectedRecords Json?               @map("detected_records")
  lastVerificationAt DateTime?        @map("last_verification_at")
  verifiedAt      DateTime?           @map("verified_at")
  sslIssuedAt     DateTime?           @map("ssl_issued_at")
  sslExpiresAt    DateTime?           @map("ssl_expires_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  landingPage  LandingPage  @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  logs         DnsVerificationLog[]

  @@index([orgId])
  @@index([domain])
  @@index([status])
  @@map("domain_requests")
  @@schema("templates")
}

model DnsVerificationLog {
  id              String   @id @default(uuid())
  domainRequestId String   @map("domain_request_id")
  checkedAt       DateTime @default(now()) @map("checked_at")
  success         Boolean
  expected        Json?
  detected        Json?
  message         String?
  createdAt       DateTime @default(now()) @map("created_at")

  domainRequest DomainRequest @relation(fields: [domainRequestId], references: [id], onDelete: Cascade)

  @@index([domainRequestId])
  @@map("dns_verification_logs")
  @@schema("templates")
}

model TrackingEvent {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  landingPageId String   @map("landing_page_id")
  eventType     String   @map("event_type")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  landingPage  LandingPage  @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

   @@index([orgId])
  @@index([landingPageId])
   @@index([eventType])
  @@map("tracking_events")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Leads — captured from the builder's lead forms (public site + previews).
// orgId is a plain scalar (no Relation field) so we don't have to thread a
// back-relation onto Organisation/LandingPage; the landingPageId is kept for
// filtering/grouping only.
// ---------------------------------------------------------------------------

model Lead {
  id            String     @id @default(uuid())
  orgId         String     @map("org_id")
  landingPageId String?    @map("landing_page_id")
  projectId     String?    @map("project_id")
  formName      String?    @map("form_name")
  source        String?    @default("website") // website | popup | floorplan | preview | project-widget
  data          Json
  status        LeadStatus @default(new)
  assignedToId  String?    @map("assigned_to_id")
  nextActionType String?   @map("next_action_type")
  nextActionAt   DateTime? @map("next_action_at")
  nextActionNote String?   @map("next_action_note")
  reminderAt     DateTime? @map("reminder_at")
  createdAt     DateTime   @default(now()) @map("created_at")

  assignedTo User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  callLogs   CallLog[]
  activities ActivityEvent[]

  @@index([orgId])
  @@index([landingPageId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Call logs — phone activity per sales agent, for the Calls & comms tab on an
// agent's dashboard. leadName is denormalised (snapshot at call time) so the
// recent-calls table renders without a join; leadId is kept for drill-through.
// ---------------------------------------------------------------------------

enum CallDirection {
  outgoing
  incoming

  @@schema("templates")
}

model CallLog {
  id              String        @id @default(uuid())
  orgId           String        @map("org_id")
  agentId         String        @map("agent_id")
  leadId          String?       @map("lead_id")
  leadName        String?       @map("lead_name")
  direction       CallDirection @default(outgoing) @map("direction")
  outcome         String        // connected | booked_visit | callback | no_answer | missed | busy
  durationSeconds Int           @default(0) @map("duration_seconds")
  createdAt       DateTime      @default(now()) @map("created_at")

  agent User? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead  Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([agentId])
  @@index([createdAt])
  @@map("call_logs")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Activity feed — the human-visible timeline on an agent's dashboard (deal
// closed, visit booked, call logged, message sent, stage changed, shift
// start). text is the ready-to-render line; type drives the icon/badging.
// ---------------------------------------------------------------------------

enum ActivityType {
  closed_deal
  site_visit_booked
  call_logged
  whatsapp_sent
  whatsapp_read
  note_added
  status_updated
  logged_in

  @@schema("templates")
}

model ActivityEvent {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  agentId   String       @map("agent_id")
  leadId    String?      @map("lead_id")
  type      ActivityType
  text      String
  createdAt DateTime     @default(now()) @map("created_at")

  agent User? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead  Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([agentId])
  @@index([createdAt])
  @@map("activity_events")
  @@schema("templates")
}

// projects — real-estate developments, their unit-type product mix, and the
// individual unit inventory beneath each type.
//   org 1─* projects 1─* unit_types 1─* units
// Every row is ultimately org-scoped: Project carries org_id directly;
// UnitType/Unit are scoped through their parent (the service always loads
// the owning Project by org_id first — see ProjectsService). No soft-delete
// anywhere, matching the rest of the codebase: deletes are hard deletes,
// paired with an audit_logs row.
// ---------------------------------------------------------------------------

enum ProjectStatus {
  active
  inactive

  @@schema("projects")
}

// Lifecycle of a captured lead in the CRM. Not driven by hard-coded casing
// order here — the allowed set only; stages are a presentation concern.
enum LeadStatus {
  new
  contacted
  follow_up
  site_visit
  negotiation
  won
  lost

  @@schema("templates")
}

enum UnitStatus {
  available
  booked
  held

  @@schema("projects")
}

// The four org-managed catalogs the project onboarding wizard picks from.
// All four are structurally identical (an org-scoped, orderable label), so
// one table keyed by this discriminator beats four near-identical tables —
// see OrgCatalogOption.
enum OrgCatalogCategory {
  project_type
  unit_type
  connectivity
  amenity

  @@schema("projects")
}

model Project {
  id                String        @id @default(uuid())
  orgId             String        @map("org_id")
  name              String
  location          String?
  reraId            String?       @map("rera_id")
  // Deliberately free text ("Dec 2027"), not a Date — see the build brief.
  possession        String?
  // FK to the org user who runs this project. Nullable — a project can be
  // unassigned. ON DELETE SET NULL: removing the user leaves the project.
  managerId         String?       @map("manager_id")
  status            ProjectStatus @default(active)
  priceMin          Int?          @map("price_min") // rupees
  priceMax          Int?          @map("price_max") // rupees
  baseRate          Int?          @map("base_rate") // rupees per sqft
  landArea          Decimal?      @map("land_area") @db.Decimal(8, 2) // acres
  towerCount        Int?          @map("tower_count")
  floorsDescription String?       @map("floors_description") // e.g. "G+22"
  // Array of { name: string, iconUrl: string | null }. iconUrl is always
  // null for now — amenity-icon upload is out of scope (blocked on S3).
  amenities         Json          @default("[]")

  // --- Onboarding-wizard fields (Steps 3-8), added by Piece A. All optional;
  // the wizard wires them progressively in Pieces B-E. `specifications` and
  // `marketing` are deliberately loose preference blobs — their inner shape
  // is expected to evolve, so they're Json rather than columns. ---
  bookingAmount          Int?     @map("booking_amount") // rupees
  currency               String   @default("INR")
  priceIncludes          String[] @default([]) @map("price_includes")
  paymentPlan            String?  @map("payment_plan")
  offers                 String?
  addressLine            String?  @map("address_line")
  city                   String?
  locality               String?
  pincode                String? // kept as text — leading zeros matter
  latitude               Float?
  longitude              Float?
  connectivity           String[] @default([]) // labels copied from the org "connectivity" catalog
  landmarks              String?
  specifications         Json? // { flooring, kitchen, doorsWindows, fittings, notes }
  marketing              Json? // { adSources, monthlyBudget, targetCpl, leadGoal, landingPageChoice, aiCallingEnabled, whatsappWelcomeEnabled, roundRobinEnabled, aiKnowledgeBaseEnabled }
  requireBookingApproval Boolean  @default(false) @map("require_booking_approval")
  visibleToTelecallers   Boolean  @default(true) @map("visible_to_telecallers")
  publishedToWebsite     Boolean  @default(false) @map("published_to_website")
  coverImageUrl          String?  @map("cover_image_url")
  galleryUrls            String[] @default([]) @map("gallery_urls")
  brochureUrl            String?  @map("brochure_url")
  reraCertificateUrl     String?  @map("rera_certificate_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organisation Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager      User?               @relation(fields: [managerId], references: [id], onDelete: SetNull)
  unitTypes    UnitType[]
  salesAgents  ProjectSalesAgent[]
  leads        Lead[]

  @@index([orgId])
  @@index([managerId])
  @@map("projects")
  @@schema("projects")
}

// Sales users assigned to work a project's leads (Step 7 of the wizard).
// Plain many-to-many, same shape as OrganisationTemplate: composite id, both
// sides cascade-delete. Links straight to User — no team concept here.
model ProjectSalesAgent {
  projectId  String   @map("project_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_sales_agents")
  @@schema("projects")
}

model UnitType {
  id          String @id @default(uuid())
  projectId   String @map("project_id")
  name        String
  carpetSqft  Int?   @map("carpet_sqft")
  builtupSqft Int?   @map("builtup_sqft")
  price       Int? // rupees — the type's base price
  // Planned/marketed unit count for this type, entered on the form. The
  // *available* count is NOT stored here — it's derived at read time from
  // the actual Unit rows' status so the two can never drift apart.
  totalUnits  Int    @default(0) @map("total_units")

  // Media — nullable, populated by no endpoint. Upload/object-storage is
  // out of scope; these columns exist so the schema is complete and the
  // future upload feature has somewhere to write.
  floorPlanUrl String?  @map("floor_plan_url")
  brochureUrl  String?  @map("brochure_url")
  videoUrl     String?  @map("video_url")
  galleryUrls  String[] @map("gallery_urls")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units   Unit[]

  @@index([projectId])
  @@map("unit_types")
  @@schema("projects")
}

model Unit {
  id         String     @id @default(uuid())
  unitTypeId String     @map("unit_type_id")
  unitNo     String     @map("unit_no") // e.g. "A-301"
  // Optional — villas / plots / single-building projects have no tower.
  // Drives the availability-grid grouping (no unitNo parsing).
  tower      String?
  floor      Int?
  facing     String? // e.g. "North-East"
  price      Int? // rupees — a unit may be priced apart from its type
  status     UnitStatus @default(available)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  unitType UnitType @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)

  @@index([unitTypeId])
  @@map("units")
  @@schema("projects")
}

// Org-managed custom catalogs — each organisation builds its own option
// lists for the project onboarding wizard (project types, unit-type labels,
// connectivity/landmark categories, amenities). Not a Super Admin global
// list, not hardcoded in the frontend. Managed from Org Settings;
// pre-created only. One generic table keyed by `category`. "Copy, don't
// reference": when a project is created the picked labels are copied onto
// the project's own columns — there is NO foreign key from a project back
// to a catalog option, so editing/deleting an option never affects an
// already-created project.
model OrgCatalogOption {
  id        String             @id @default(uuid())
  orgId     String             @map("org_id")
  category  OrgCatalogCategory
  label     String
  // Manual display order within one (org, category) list; ties broken by label.
  sortOrder Int                @default(0) @map("sort_order")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, category, label])
  @@index([orgId, category])
  @@map("org_catalog_options")
  @@schema("projects")
}
