generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "access", "templates", "audit", "billing"]
}

// ---------------------------------------------------------------------------
// Enums
// (Enums belong to whichever schema uses them; Prisma requires one
//  @@schema per enum too when multiSchema is on.)
// ---------------------------------------------------------------------------

enum OrgStatus {
  draft
  active
  disabled
  pending

  @@schema("identity")
}

enum UserStatus {
  active
  disabled

  @@schema("identity")
}

enum RoleScope {
  platform
  organisation
  team

  @@schema("identity")
}

// ---------------------------------------------------------------------------
// identity — organisations, users, roles, auth tokens
// (Same idea as QuesPro's "admin" schema — the core identity/account layer)
// ---------------------------------------------------------------------------

model Organisation {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  city      String
  status    OrgStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at")

  // Profile fields — added for the Org Admin settings screen. All nullable
  // except the three with sensible defaults; existing orgs backfill to those.
  timezone        String  @default("Asia/Kolkata")
  currency        String  @default("INR")
  defaultLanguage String  @default("en-IN") @map("default_language")
  logoUrl         String? @map("logo_url")
  faviconUrl      String? @map("favicon_url")
  brandColour     String? @map("brand_colour")
  website         String?
  addressLine1    String? @map("address_line1")
  addressLine2    String? @map("address_line2")
  state           String?
  postalCode      String? @map("postal_code")
  country         String?

  users                 User[]
  teams                 Team[]
  auditLogs             AuditLog[]
  subscriptions         Subscription[]
  organisationTemplates OrganisationTemplate[]
  landingPages          LandingPage[]
  typographySets        TypographySet[]
  domainRequests        DomainRequest[]
  trackingEvents        TrackingEvent[]

  @@map("organisations")
  @@schema("identity")
}

model User {
  id                  String     @id @default(uuid())
  orgId               String?    @map("org_id")
  firstName           String?    @map("first_name")
  lastName            String?    @map("last_name")
  email               String     @unique
  phoneNumber         String?    @map("phone_number")
  passwordHash        String     @map("password_hash")
  status              UserStatus @default(active)
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  createdAt           DateTime   @default(now()) @map("created_at")

  organisation  Organisation?        @relation(fields: [orgId], references: [id])
  userRoles     UserRole[]
  teamMembers   TeamMember[]
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]

  @@map("users")
  @@schema("identity")
}

model Role {
  id        String    @id @default(uuid())
  key       String    @unique // super_admin / admin / manager / sales
  name      String
  scope     RoleScope
  sortOrder Int       @default(0) @map("sort_order")

  userRoles   UserRole[]
  permissions RoleModulePermission[]

  @@map("roles")
  @@schema("identity")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("identity")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@schema("identity")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@schema("identity")
}

// ---------------------------------------------------------------------------
// access — teams, membership, and the two-layer permission model
// ---------------------------------------------------------------------------

model Team {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  moduleAccess TeamModuleAccess[]

  @@map("teams")
  @@schema("access")
}

model TeamMember {
  teamId String @map("team_id")
  userId String @map("user_id")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
  @@schema("access")
}

// Layer 1 — which modules are in scope for a team at all
model TeamModuleAccess {
  teamId    String  @map("team_id")
  moduleKey String  @map("module_key")
  isEnabled Boolean @default(true) @map("is_enabled")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, moduleKey])
  @@map("team_module_access")
  @@schema("access")
}

// Layer 2 — what a role can do within a module, once it's in scope for the team
model RoleModulePermission {
  roleId    String  @map("role_id")
  moduleKey String  @map("module_key")
  canView   Boolean @default(true) @map("can_view")
  canAdd    Boolean @default(false) @map("can_add")
  canEdit   Boolean @default(false) @map("can_edit")
  canDelete Boolean @default(false) @map("can_delete")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, moduleKey])
  @@map("role_module_permissions")
  @@schema("access")
}

// ---------------------------------------------------------------------------
// audit — logging, kept separate the same way QuesPro isolates "audit"
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  orgId     String?  @map("org_id")
  actorId   String?  @map("actor_id")
  moduleKey String?  @map("module_key")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [orgId], references: [id])
  actor        User?         @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
  @@schema("audit")
}

// ---------------------------------------------------------------------------
// templates — Super Admin landing-page template library (builder content
// lives in `content`, stored as-is; the frontend owns the shape of that JSON)
// ---------------------------------------------------------------------------

enum TemplateStatus {
  draft
  published
  scheduled
  password
  unpublished

  @@schema("templates")
}

enum TemplateKind {
  preset
  custom

  @@schema("templates")
}

enum TemplatePageType {
  landing
  thank_you

  @@schema("templates")
}

model Template {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  status         TemplateStatus   @default(draft)
  isPaid         Boolean          @default(false) @map("is_paid")
  thumbnail      String?
  designId       String           @map("design_id")
  baseDesignName String           @map("base_design_name")
  category       String?
  kind           TemplateKind     @default(custom)
  pageType       TemplatePageType @default(landing) @map("page_type")
  parentId       String?          @map("parent_id")
  domain         String           @default("")
  content        Json
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  parent                Template?              @relation("TemplatePages", fields: [parentId], references: [id], onDelete: SetNull)
  childPages            Template[]             @relation("TemplatePages")
  organisationTemplates OrganisationTemplate[]
  landingPages          LandingPage[]

  @@map("templates")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// billing — plans & subscriptions
// ---------------------------------------------------------------------------

enum BillingCycle {
  monthly
  yearly

  @@schema("billing")
}

enum SubscriptionStatus {
  active
  past_due
  trial
  cancelled
  paused

  @@schema("billing")
}

model Plan {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?  @default("")
  priceMonthly Int      @map("price_monthly")
  priceYearly  Int      @map("price_yearly")
  features     Json     @default("[]")
  limits       Json? // { projects, users, templates }
  color        String   @default("#eef0fe")
  badge        String   @default("b-indigo")
  isPopular    Boolean  @default(false) @map("is_popular")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
  @@schema("billing")
}

model Subscription {
  id           String             @id @default(uuid())
  orgId        String             @map("org_id")
  planId       String             @map("plan_id")
  billingCycle BillingCycle       @default(monthly) @map("billing_cycle")
  status       SubscriptionStatus @default(active)
  amount       Int
  currency     String             @default("INR")
  renewsAt     DateTime?          @map("renews_at")
  mrr          Int? // monthly recurring normalized value
  startedAt    DateTime           @default(now()) @map("started_at")
  cancelledAt  DateTime?          @map("cancelled_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
  @@schema("billing")
}

model OrganisationTemplate {
  orgId      String   @map("org_id")
  templateId String   @map("template_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([orgId, templateId])
  @@index([templateId])
  @@map("organisation_templates")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Org-owned landing pages — an org's own independent, editable copy made by
// "using" an assigned Template. The Template row is never mutated by this;
// see LandingPagesService for the copy-on-use guarantee.
// ---------------------------------------------------------------------------

enum LandingPageStatus {
  draft
  pending_approval
  approved
  rejected
  published
  unpublished

  @@schema("templates")
}

model LandingPage {
  id               String            @id @default(uuid())
  orgId            String            @map("org_id")
  teamId           String?           @map("team_id") // nullable — reserved for later team-level delegation, unused for now
  sourceTemplateId String?           @map("source_template_id")
  name             String
  slug             String
  status           LandingPageStatus @default(draft)
  content          Json // { sections, config } — the org's own copy
  thumbnail        String?
  pageType         TemplatePageType  @default(landing) @map("page_type")
  parentId         String?           @map("parent_id") // thank-you companion linkage, among the org's own pages
  submittedAt      DateTime?         @map("submitted_at")
  reviewedAt       DateTime?         @map("reviewed_at")
  reviewedById     String?           @map("reviewed_by_id")
  rejectionReason  String?           @map("rejection_reason")
  publishedAt      DateTime?         @map("published_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organisation   Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sourceTemplate Template?     @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  parent         LandingPage?  @relation("LandingPageCompanion", fields: [parentId], references: [id], onDelete: SetNull)
  children       LandingPage[] @relation("LandingPageCompanion")
  domainRequest  DomainRequest?
  trackingEvents TrackingEvent[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([status])
  @@map("landing_pages")
  @@schema("templates")
}

model TypographySet {
  id        String   @id @default(uuid())
  orgId     String?  @map("org_id") // null = platform-wide set (Super Admin owned)
  name      String
  tokens    Json // the design-system token payload (TemplateTypography), stored as-is
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organisation Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // NOTE: Postgres never treats two NULLs as equal for uniqueness, so this
  // does NOT stop two platform sets (orgId: null) from sharing a name — it
  // only blocks duplicate names within one real org. Accepted deliberately:
  // platform sets are Super-Admin-only, a single trusted role that can just
  // not do that, and a real DB-level fix needs a partial unique index
  // (WHERE org_id IS NULL) outside what this schema DSL can express.
  @@unique([orgId, name])
  @@map("typography_sets")
  @@schema("templates")
}

// ---------------------------------------------------------------------------
// Template-isolated website stack — Organisation → Template → Pages → Domain
// → DNS → SSL → Tracking → SEO → Publishing. Every LandingPage is an
// independent website instance (see prompt §1, §30).
// ---------------------------------------------------------------------------

enum DomainRequestStatus {
  pending
  approved
  rejected
  dns_required
  verification_pending
  verified
  ssl_pending
  connected
  verification_failed
  connection_failed

  @@schema("templates")
}

enum DnsStatus {
  pending
  verified
  failed

  @@schema("templates")
}

enum SslStatus {
  pending
  active
  failed
  expired

  @@schema("templates")
}

model DomainRequest {
  id              String              @id @default(uuid())
  orgId           String              @map("org_id")
  landingPageId   String              @unique @map("landing_page_id")
  domain          String
  status          DomainRequestStatus @default(pending)
  requestedBy     String?             @map("requested_by")
  requestedAt     DateTime            @default(now()) @map("requested_at")
  reviewedAt      DateTime?           @map("reviewed_at")
  reviewedBy      String?             @map("reviewed_by")
  rejectionReason String?             @map("rejection_reason")
  dnsStatus       DnsStatus           @default(pending) @map("dns_status")
  sslStatus       SslStatus           @default(pending) @map("ssl_status")
  verificationToken String            @map("verification_token")
  dnsInstructions Json?               @map("dns_instructions")
  expectedRecords Json?               @map("expected_records")
  detectedRecords Json?               @map("detected_records")
  lastVerificationAt DateTime?        @map("last_verification_at")
  verifiedAt      DateTime?           @map("verified_at")
  sslIssuedAt     DateTime?           @map("ssl_issued_at")
  sslExpiresAt    DateTime?           @map("ssl_expires_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  landingPage  LandingPage  @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  logs         DnsVerificationLog[]

  @@index([orgId])
  @@index([domain])
  @@index([status])
  @@map("domain_requests")
  @@schema("templates")
}

model DnsVerificationLog {
  id              String   @id @default(uuid())
  domainRequestId String   @map("domain_request_id")
  checkedAt       DateTime @default(now()) @map("checked_at")
  success         Boolean
  expected        Json?
  detected        Json?
  message         String?
  createdAt       DateTime @default(now()) @map("created_at")

  domainRequest DomainRequest @relation(fields: [domainRequestId], references: [id], onDelete: Cascade)

  @@index([domainRequestId])
  @@map("dns_verification_logs")
  @@schema("templates")
}

model TrackingEvent {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  landingPageId String   @map("landing_page_id")
  eventType     String   @map("event_type")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  landingPage  LandingPage  @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([landingPageId])
  @@index([eventType])
  @@map("tracking_events")
  @@schema("templates")
}
