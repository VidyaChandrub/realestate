generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// MODULE 1 — Auth, Roles & Permissions, Teams, Templates  (already migrated)
// =============================================================================

// ---------------------------------------------------------------------------
// Enums — Module 1
// ---------------------------------------------------------------------------

enum OrgStatus {
  active
  disabled
}

enum UserStatus {
  active
  disabled
}

enum RoleScope {
  platform
  organisation
  team
}

enum TemplateType {
  free
  paid
}

enum PricingModel {
  global
  org_specific
}

enum TemplateStatus {
  draft
  active
}

enum PaymentStatus {
  not_required
  pending
  paid
  verified
}

// ---------------------------------------------------------------------------
// Organisations & Users
// ---------------------------------------------------------------------------

model Organisation {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  status    OrgStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at")

  users                 User[]
  teams                 Team[]
  organisationTemplates OrganisationTemplate[]
  auditLogs             AuditLog[]

  // Module 2+ back-relations
  projects              Project[]
  landingPages          LandingPage[]
  landingPageLeads      LandingPageLead[]
  adAccounts            AdAccount[]
  campaigns             Campaign[]
  leads                 Lead[]
  deals                 Deal[]
  whatsappConversations WhatsappConversation[]
  aiSignals             AiSignal[]
  aiInsights            AiInsight[]
  aiRecommendations     AiRecommendation[]
  notifications         Notification[]

  @@map("organisations")
}

model User {
  id                  String     @id @default(uuid())
  orgId               String?    @map("org_id")
  firstName           String?    @map("first_name")
  lastName            String?    @map("last_name")
  email               String     @unique
  phoneNumber         String?    @map("phone_number")
  passwordHash        String     @map("password_hash")
  status              UserStatus @default(active)
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  createdAt           DateTime   @default(now()) @map("created_at")

  organisation  Organisation?        @relation(fields: [orgId], references: [id])
  userRoles     UserRole[]
  teamMembers   TeamMember[]
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]

  // Module 2+ back-relations
  approvedLandingPages LandingPage[]  @relation("LandingPageApprovedBy")
  assignedLeads        Lead[]
  leadActivities       LeadActivity[]
  notifications        Notification[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Roles & Permissions
// ---------------------------------------------------------------------------

model Role {
  id        String    @id @default(uuid())
  key       String    @unique // super_admin / admin / manager / sales
  name      String
  scope     RoleScope
  sortOrder Int       @default(0) @map("sort_order")

  userRoles   UserRole[]
  permissions RoleModulePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Layer 2 — what a role can do within a module, once that module is in scope for the team
model RoleModulePermission {
  roleId    String  @map("role_id")
  moduleKey String  @map("module_key")
  canView   Boolean @default(true) @map("can_view")
  canAdd    Boolean @default(false) @map("can_add")
  canEdit   Boolean @default(false) @map("can_edit")
  canDelete Boolean @default(false) @map("can_delete")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, moduleKey])
  @@map("role_module_permissions")
}

// ---------------------------------------------------------------------------
// Teams
// ---------------------------------------------------------------------------

model Team {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  organisation   Organisation         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  moduleAccess   TeamModuleAccess[]
  templateAccess TeamTemplateAccess[]

  // Module 2+ back-relations
  landingPages  LandingPage[]
  assignedLeads Lead[]
  notifications Notification[]

  @@map("teams")
}

model TeamMember {
  teamId String @map("team_id")
  userId String @map("user_id")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

// Layer 1 — which modules are in scope for a team at all (no CRUD detail here)
model TeamModuleAccess {
  teamId    String  @map("team_id")
  moduleKey String  @map("module_key")
  isEnabled Boolean @default(true) @map("is_enabled")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, moduleKey])
  @@map("team_module_access")
}

// ---------------------------------------------------------------------------
// Templates
// ---------------------------------------------------------------------------

model Template {
  id           String         @id @default(uuid())
  name         String
  type         TemplateType
  pricingModel PricingModel?  @map("pricing_model")
  basePrice    Decimal?       @map("base_price") @db.Decimal(10, 2)
  previewImage String?        @map("preview_image")
  status       TemplateStatus @default(draft)
  createdAt    DateTime       @default(now()) @map("created_at")

  organisationTemplates OrganisationTemplate[]
  teamTemplateAccess    TeamTemplateAccess[]
  landingPages          LandingPage[]

  @@map("templates")
}

model OrganisationTemplate {
  orgId            String        @map("org_id")
  templateId       String        @map("template_id")
  orgSpecificPrice Decimal?      @map("org_specific_price") @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(not_required) @map("payment_status")
  activatedAt      DateTime?     @map("activated_at")
  assignedAt       DateTime      @default(now()) @map("assigned_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template     Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([orgId, templateId])
  @@map("organisation_templates")
}

model TeamTemplateAccess {
  teamId     String   @map("team_id")
  templateId String   @map("template_id")
  grantedAt  DateTime @default(now()) @map("granted_at")

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([teamId, templateId])
  @@map("team_template_access")
}

// ---------------------------------------------------------------------------
// Auth support tables
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  orgId     String?  @map("org_id")
  actorId   String?  @map("actor_id")
  moduleKey String?  @map("module_key")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation? @relation(fields: [orgId], references: [id])
  actor        User?         @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

// =============================================================================
// MODULE 2 — Projects & Units (real estate inventory, data-only, no access control)
// =============================================================================

enum ProjectStatus {
  upcoming
  ongoing
  completed
}

enum UnitType {
  flat
  villa
  plot
  commercial
}

enum UnitStatus {
  available
  held
  sold
}

model Project {
  id          String        @id @default(uuid())
  orgId       String        @map("org_id")
  name        String
  slug        String
  city        String?
  reraNumber  String?       @map("rera_number")
  status      ProjectStatus @default(upcoming)
  createdAt   DateTime      @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  units        Unit[]
  landingPages LandingPage[]
  campaigns    Campaign[]
  leads        Lead[]
  siteVisits   SiteVisit[]

  @@map("projects")
}

model Unit {
  id         String     @id @default(uuid())
  projectId  String     @map("project_id")
  unitNumber String     @map("unit_number")
  type       UnitType
  sizeSqft   Decimal?   @map("size_sqft") @db.Decimal(10, 2)
  price      Decimal?   @db.Decimal(14, 2)
  status     UnitStatus @default(available)
  createdAt  DateTime   @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deals   Deal[]

  @@map("units")
}

// =============================================================================
// MODULE 3 — Landing Pages (team-owned, template-built, subdomain, approval gate)
// =============================================================================

enum LandingPageStatus {
  draft
  pending_approval
  approved
  rejected
  published
}

model LandingPage {
  id                String            @id @default(uuid())
  teamId            String            @map("team_id")
  orgId             String            @map("org_id")
  templateId        String            @map("template_id")
  projectId         String?           @map("project_id")
  name              String
  subdomain         String            @unique
  customDomain      String?           @map("custom_domain")
  status            LandingPageStatus @default(draft)
  gtmId             String?           @map("gtm_id")
  seoTitle          String?           @map("seo_title")
  seoDescription    String?           @map("seo_description")
  submittedAt       DateTime?         @map("submitted_at")
  approvedById      String?           @map("approved_by")
  approvedAt        DateTime?         @map("approved_at")
  rejectedReason    String?           @map("rejected_reason")
  publishedAt       DateTime?         @map("published_at")
  createdAt         DateTime          @default(now()) @map("created_at")

  team         Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  organisation Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template     Template          @relation(fields: [templateId], references: [id])
  project      Project?          @relation(fields: [projectId], references: [id])
  approvedBy   User?             @relation("LandingPageApprovedBy", fields: [approvedById], references: [id])
  sections     LandingPageSection[]
  formLeads    LandingPageLead[]
  leads        Lead[]

  @@map("landing_pages")
}

// Each page's sections are its own independent copy — editing one page never
// affects another, even if both started from the same template.
model LandingPageSection {
  id            String @id @default(uuid())
  landingPageId String @map("landing_page_id")
  sectionKey    String @map("section_key")
  content       Json
  sortOrder     Int    @default(0) @map("sort_order")

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@map("landing_page_sections")
}

// Raw form submission from a public landing page, before it's promoted into
// a proper Lead — keeps the unauthenticated public write path narrow.
model LandingPageLead {
  id            String   @id @default(uuid())
  landingPageId String   @map("landing_page_id")
  orgId         String   @map("org_id")
  name          String?
  phone         String?
  email         String?
  message       String?
  utmSource     String?  @map("utm_source")
  utmCampaign   String?  @map("utm_campaign")
  utmMedium     String?  @map("utm_medium")
  convertedToLeadId String? @map("converted_to_lead_id")
  createdAt     DateTime @default(now()) @map("created_at")

  landingPage  LandingPage  @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("landing_page_leads")
}

// =============================================================================
// MODULE 4 — Campaign Centre
// =============================================================================

enum AdPlatform {
  google
  meta
}

model AdAccount {
  id                 String     @id @default(uuid())
  orgId              String     @map("org_id")
  platform           AdPlatform
  externalAccountId  String     @map("external_account_id")
  accessTokenRef     String?    @map("access_token_ref") // reference to secret store, never the raw token
  status             String     @default("active")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@map("ad_accounts")
}

model Campaign {
  id                 String     @id @default(uuid())
  orgId              String     @map("org_id")
  projectId          String?    @map("project_id")
  adAccountId        String     @map("ad_account_id")
  platform           AdPlatform
  externalCampaignId String     @map("external_campaign_id")
  name               String
  status             String     @default("active")
  budget             Decimal?   @db.Decimal(12, 2)
  startDate          DateTime?  @map("start_date")
  endDate            DateTime?  @map("end_date")

  organisation Organisation          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?              @relation(fields: [projectId], references: [id])
  adAccount    AdAccount             @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  metricsDaily CampaignMetricDaily[]
  leads        Lead[]

  @@map("campaigns")
}

model CampaignMetricDaily {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  date        DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(12, 2)
  conversions Int      @default(0)
  ctr         Decimal? @db.Decimal(6, 4)
  cpc         Decimal? @db.Decimal(10, 2)
  roi         Decimal? @db.Decimal(10, 2)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@map("campaign_metrics_daily")
}

// =============================================================================
// MODULE 5 — Lead Centre (real estate specific: budget, unit preference, site visits)
// =============================================================================

enum LeadSource {
  campaign
  landing_page
  whatsapp
  manual
}

enum LeadStatus {
  captured
  tagged
  qualified
  assigned
  site_visit_scheduled
  won
  lost
}

enum ActivityChannel {
  phone
  whatsapp
  ai_calling
  email
  system
}

enum ActivityDirection {
  inbound
  outbound
}

enum SiteVisitStatus {
  scheduled
  completed
  no_show
  cancelled
}

enum DealPipelineStatus {
  open
  won
  lost
}

model Lead {
  id             String     @id @default(uuid())
  orgId          String     @map("org_id")
  projectId      String?    @map("project_id")
  source         LeadSource
  campaignId     String?    @map("campaign_id")
  landingPageId  String?    @map("landing_page_id")
  name           String?
  phone          String?
  email          String?
  budgetMin      Decimal?   @map("budget_min") @db.Decimal(14, 2)
  budgetMax      Decimal?   @map("budget_max") @db.Decimal(14, 2)
  unitPreference String?    @map("unit_preference")
  tags           String[]
  status         LeadStatus @default(captured)
  assignedTeamId String?    @map("assigned_team_id")
  assignedUserId String?    @map("assigned_user_id")
  priority       Int        @default(0)
  duplicateOfId  String?    @map("duplicate_of")
  createdAt      DateTime   @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])
  landingPage  LandingPage? @relation(fields: [landingPageId], references: [id])
  assignedTeam Team?        @relation(fields: [assignedTeamId], references: [id])
  assignedUser User?        @relation(fields: [assignedUserId], references: [id])

  duplicateOf Lead?  @relation("LeadDuplicates", fields: [duplicateOfId], references: [id])
  duplicates  Lead[] @relation("LeadDuplicates")

  qualificationScores  LeadQualificationScore[]
  activities           LeadActivity[]
  siteVisits           SiteVisit[]
  deal                 Deal?
  whatsappConversations WhatsappConversation[]
  calendarEvents       CalendarEvent[]
  aiSignals            AiSignal[]
  aiInsights           AiInsight[]
  aiRecommendations    AiRecommendation[]

  @@map("leads")
}

model LeadQualificationScore {
  id               String   @id @default(uuid())
  leadId           String   @map("lead_id")
  modelConfidence  Decimal? @map("model_confidence") @db.Decimal(5, 4)
  intentStrength   Decimal? @map("intent_strength") @db.Decimal(5, 4)
  budgetScore      Decimal? @map("budget_score") @db.Decimal(5, 4)
  timelineScore    Decimal? @map("timeline_score") @db.Decimal(5, 4)
  priorityScore    Decimal? @map("priority_score") @db.Decimal(5, 4)
  computedAt       DateTime @default(now()) @map("computed_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_qualification_scores")
}

model LeadActivity {
  id        String            @id @default(uuid())
  leadId    String            @map("lead_id")
  channel   ActivityChannel
  direction ActivityDirection
  content   String?
  actorId   String?           @map("actor_id")
  createdAt DateTime          @default(now()) @map("created_at")

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@map("lead_activities")
}

model SiteVisit {
  id          String          @id @default(uuid())
  leadId      String          @map("lead_id")
  projectId   String?         @map("project_id")
  scheduledAt DateTime        @map("scheduled_at")
  status      SiteVisitStatus @default(scheduled)
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@map("site_visits")
}

model Deal {
  id             String              @id @default(uuid())
  leadId         String              @unique @map("lead_id")
  orgId          String              @map("org_id")
  unitId         String?             @map("unit_id")
  stage          String?
  momentumScore  Decimal?            @map("momentum_score") @db.Decimal(5, 4)
  pipelineStatus DealPipelineStatus  @default(open) @map("pipeline_status")
  wonAt          DateTime?           @map("won_at")
  lostReason     String?             @map("lost_reason")
  createdAt      DateTime            @default(now()) @map("created_at")

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit         Unit?        @relation(fields: [unitId], references: [id])
  handshakes   Handshake[]

  @@map("deals")
}

// =============================================================================
// MODULE 6 — WhatsApp Centre
// =============================================================================

enum ConversationStatus {
  healthy
  at_risk
  escalated
}

model WhatsappConversation {
  id            String              @id @default(uuid())
  orgId         String              @map("org_id")
  leadId        String?             @map("lead_id")
  phoneNumber   String              @map("phone_number")
  status        ConversationStatus  @default(healthy)
  lastMessageAt DateTime?           @map("last_message_at")

  organisation Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead?           @relation(fields: [leadId], references: [id])
  messages     WhatsappMessage[]
  calendarEvents CalendarEvent[]
  handshakes   Handshake[]

  @@map("whatsapp_conversations")
}

model WhatsappMessage {
  id             String            @id @default(uuid())
  conversationId String            @map("conversation_id")
  direction      ActivityDirection
  content        String?
  sentiment      String?
  intent         String?
  createdAt      DateTime          @default(now()) @map("created_at")

  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_messages")
}

model CalendarEvent {
  id             String   @id @default(uuid())
  conversationId String?  @map("conversation_id")
  leadId         String?  @map("lead_id")
  scheduledAt    DateTime @map("scheduled_at")
  status         String   @default("scheduled")
  meetingLink    String?  @map("meeting_link")

  conversation WhatsappConversation? @relation(fields: [conversationId], references: [id])
  lead         Lead?                 @relation(fields: [leadId], references: [id])

  @@map("calendar_events")
}

model Handshake {
  id             String   @id @default(uuid())
  dealId         String   @map("deal_id")
  conversationId String   @map("conversation_id")
  agreedAt       DateTime @default(now()) @map("agreed_at")

  deal         Deal                 @relation(fields: [dealId], references: [id], onDelete: Cascade)
  conversation WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("handshakes")
}

// =============================================================================
// MODULE 7 — AI Centre (unified signal store, insights, recommendations)
// =============================================================================

enum AiSignalSource {
  campaign
  lead
  whatsapp
  crm
}

enum RecommendationStatus {
  pending
  acted
  dismissed
}

model AiSignal {
  id         String         @id @default(uuid())
  orgId      String         @map("org_id")
  leadId     String?        @map("lead_id")
  source     AiSignalSource
  signalType String         @map("signal_type")
  payload    Json
  createdAt  DateTime       @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@map("ai_signals")
}

model AiInsight {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  leadId       String?  @map("lead_id")
  intent       String?
  sentiment    String?
  riskScore    Decimal? @map("risk_score") @db.Decimal(5, 4)
  explanation  String?
  modelVersion String?  @map("model_version")
  createdAt    DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@map("ai_insights")
}

model AiRecommendation {
  id                String                @id @default(uuid())
  orgId             String                @map("org_id")
  leadId            String?               @map("lead_id")
  recommendedAction String                @map("recommended_action")
  rank              Int?
  status            RecommendationStatus  @default(pending)
  createdAt         DateTime              @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@map("ai_recommendations")
}

// =============================================================================
// MODULE 8 — Notification Centre (fan-in from every module above)
// =============================================================================

model Notification {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  userId      String?   @map("user_id")
  teamId      String?   @map("team_id")
  moduleSource String?  @map("module_source") // campaign / lead / whatsapp / ai / risk / reminder
  type        String
  payload     Json?
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])

  @@map("notifications")
}
